{
  "name": "pulse-web-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    ">>> SERVER <<<": "",
    "server:development": "dotnet --version TODO: Run the server specifically on host and port",
    ">>> COPY <<<": "",
    "copy:android": "npx cap copy android",
    "copy:ios": "npx cap copy ios",
    ">>> BUILD <<<": "",
    "< Build Development >": "",
    "build:development:web": "vite build --mode development",
    "build:development:android": "npm run build:development:web && npm run copy:android",
    "build:development:ios": "npm run build:development:web && npm run copy:ios",
    "build:development:all": "npm run build:development:web && npm run copy:android && npm run copy:ios",
    "< Build Staging >": "",
    "build:staging:web": "tsc && vite build --mode staging",
    "build:staging:android": "npm run build:staging:web && npm run copy:android",
    "build:staging:ios": "npm run build:staging:web && npm run copy:ios",
    "build:staging:all": "npm run build:staging:web && npm run copy:android && npm run copy:ios",
    "< Build Production >": "",
    "build:production:web": "tsc && vite build --mode production",
    "build:production:android": "npm run build:production:web && copy:android",
    "build:production:ios": "npm run build:production:web && npm run copy:ios",
    "build:production:all": "npm run build:production:web && npm run copy:android && npm run copy:ios",
    ">>> VITE LIVE RELOAD <<<": "",
    "< Live Reload Development >": "",
    "live:development:web": "vite --host --mode development --open",
    "live:development:android": "dotenv -e .env.development -- concurrently \"vite --host --mode development\" \"node scripts/live-android.js\"",
    "live:development:ios": "dotenv -e .env.development -- concurrently \"vite --host --mode development\" \"node scripts/live-ios.js\"",
    "live:development:all": "concurrently \"vite --host --mode development --open\" \"node scripts/live-android.js\"",
    "< Live Reload Staging >": "",
    "live:staging:web": "tsc && vite --host --mode staging --open",
    "live:staging:android": "dotenv -e .env.staging -- concurrently \"vite --host --mode staging\" \"node scripts/live-android.js\"",
    "live:staging:ios": "dotenv -e .env.staging -- concurrently \"vite --host --mode staging\" \"node scripts/live-ios.js\"",
    "live:staging:all": "concurrently \"vite --host --mode staging --open\" \"npx cap run android -l --host $VITE_CAP_HOST --port $VITE_CAP_PORT\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "remixicon": "^4.9.1"
  }
}
