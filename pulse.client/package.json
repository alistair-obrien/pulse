{
  "name": "pulse-web-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {    
    ">>> VITE LIVE RELOAD <<<": "Starts Vite live reload server",
    
    "< Live Reload Local Server >": "",
    "live:localhost:web": "vite --host --mode localhost --open",
    "live:localhost:android": "dotenv -e .env.localhost -- concurrently \"vite --host --mode localhost\" \"node scripts/live-android.js\"",
    "live:localhost:ios": "dotenv -e .env.localhost -- concurrently \"vite --host --mode localhost\" \"node scripts/live-ios.js\"",
    "live:localhost": "dotenv -e .env.localhost -- concurrently \"vite --host --mode localhost --open\" \"node scripts/live-android.js\" \"node scripts/live-ios.js\"",
    
    "< Live Reload Development Server >": "",
    "live:development:web": "vite --host --mode development --open",
    "live:development:android": "dotenv -e .env.development -- concurrently \"vite --host --mode development\" \"node scripts/live-android.js\"",
    "live:development:ios": "dotenv -e .env.development -- concurrently \"vite --host --mode development\" \"node scripts/live-ios.js\"",
    "live:development": "dotenv -e .env.development -- concurrently \"vite --host --mode development --open\" \"node scripts/live-android.js\" \"node scripts/live-ios.js\"",
    
    "< Live Reload Production Server >": "",
    "live:production:web": "vite --host --mode production --open",
    "live:production:android": "dotenv -e .env.production -- concurrently \"vite --host --mode production\" \"node scripts/live-android.js\"",
    "live:production:ios": "dotenv -e .env.production -- concurrently \"vite --host --mode production\" \"node scripts/live-ios.js\"",
    "live:production": "dotenv -e .env.production -- concurrently \"vite --host --mode production --open\" \"node scripts/live-android.js\" \"node scripts/live-ios.js\""
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/toast": "^8.0.1",
    "@capgo/capacitor-social-login": "^8.3.39",
    "remixicon": "^4.9.1"
  }
}